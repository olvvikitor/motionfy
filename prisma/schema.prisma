generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String  @id @default(uuid())
  email           String?
  password        String?
  accessToken     String?
  refreshToken    String?
  country         String
  provider        String
  display_name    String
  img_profile       String
  face_photo_path   String?
  image_credits     Decimal @default(1) @db.Decimal(10, 2) // créditos; playlists longas custam frações (0,30 / 0,50 / 0,75)
  notificateEmail Boolean @default(false)
  notificatePush  Boolean @default(false)
  notificateWeek  Boolean @default(false)

  histories    ListeningHistory[]
  playlistSuggestions PlaylistSuggestion[]
  mofyPlaylists MofyPlaylist[]
  coverGenerations CoverGeneration[]
  moodAnalyses MoodAnalysis[]
  creditLogs   CreditLog[]
  creditPurchases CreditPurchase[]
  pet          Pet?
  reactions    MoodReaction[]
  comments     MoodComment[]
  playlistReactions PlaylistReaction[]
  playlistComments  PlaylistComment[]

  sentFriendRequests     Friendship[] @relation("FriendshipRequester")
  receivedFriendRequests Friendship[] @relation("FriendshipAddressee")

  @@unique([email, provider])
}

model CreditLog {
  id        String          @id @default(uuid())
  userId    String
  type      CreditLogType
  amount    Decimal         @db.Decimal(10, 2)
  note      String?
  createdAt DateTime        @default(now())

  user User @relation(fields: [userId], references: [id])
}

// Compra de créditos pelo Stripe Checkout. Uma linha por sessão: é o que impede creditar
// duas vezes (webhook repetido ou webhook + confirmação na volta do checkout).
model CreditPurchase {
  id              String    @id @default(uuid())
  userId          String
  stripeSessionId String    @unique
  packageId       String
  credits         Int
  amountCents     Int
  currency        String
  status          String    @default("pending") // pending | paid | expired
  paidAt          DateTime?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum CreditLogType {
  PURCHASE
  CONSUME
  BONUS
  REFUND
}

model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id])
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id])

  @@unique([requesterId, addresseeId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

model Track {
  id        String             @id @default(uuid())
  spotifyId String?            @unique
  title     String
  artist    String
  album     String?
  img_url   String?
  isrc        String?
  explicit    Boolean?
  releaseDate String?
  durationMs  Int?
  createdAt DateTime           @default(now())
  histories ListeningHistory[]
}

model TracksAnalysis {
  id                String   @unique @default(uuid())
  spotifyid         String   @unique
  moodScore         Float
  dominantSentiment String
  coreAxes          Json
  emotionalVector   Json
  reasoning         String
  genre             String
  subgenre          String
  bpm               Int?     // do Deezer (null = desconhecido); filtro de BPM da playlist
  analyzedAt        DateTime @default(now())
}

// País de cada artista (filtro de música nacional). Um por artista principal, consultado uma vez
// (MusicBrainz; sem país lá, tags do Last.fm). country null = não descoberto (vale o ISRC/gênero).
model ArtistInfo {
  name      String   @id // artista principal em minúsculas
  country   String? // ISO 3166 alfa-2, ex. "BR"
  source    String // "musicbrainz" | "lastfm" | "none"
  checkedAt DateTime @default(now())
}

model MoodAnalysis {
  id              String   @id @default(uuid())
  moodScore       Float
  sentiment       String
  image_mood      String?
  coreAxes        Json
  emotions        Json
  analyzedAt      DateTime @default(now()) // renovado enquanto o humor segue
  startedAt       DateTime @default(now()) // quando o humor começou (feed: "foi de X para Y")
  tracksAnalyzeds Json
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  reactions       MoodReaction[]
  comments        MoodComment[]

  @@index([userId, startedAt])
}

// Playlists criadas na conta do Mofy no Spotify (o usuário recebe o link; não precisa de login no Spotify).
// tracksHash = mesma lista de músicas na mesma ordem: reaproveita o link em vez de criar outra.
model MofyPlaylist {
  id                String   @id @default(uuid())
  userId            String
  spotifyPlaylistId String
  url               String
  tracksHash        String
  // Para o card no perfil (playlists antigas ficam sem: o card usa o que der).
  title             String?
  sentiment         String?  // humor da playlist (a chegada, na jornada)
  fromSentiment     String?  // partida, na jornada; igual ao sentiment em "um humor"
  trackIds          Json?    // ids do Spotify, na ordem
  coverUrl          String?  // capa enviada ou gerada (sem ela, o card usa a da música mais forte)
  // Playlist do próprio usuário no Spotify, trazida pelo link: não fica na conta do Mofy (nunca é apagada
  // nem gerada de novo lá) e a capa gerada só fica no Mofy, para baixar.
  imported          Boolean  @default(false)
  createdAt         DateTime @default(now())
  removedAt         DateTime?
  user              User     @relation(fields: [userId], references: [id])
  reactions         PlaylistReaction[]
  comments          PlaylistComment[]

  @@index([userId, createdAt])
  @@index([userId, tracksHash])
}

// Cada capa gerada pela IA: o prompt exato e onde a imagem ficou (para ver em GET admin/covers).
model CoverGeneration {
  id             String   @id @default(uuid())
  userId         String
  mofyPlaylistId String
  title          String?
  sentiment      String
  reference      String   // none | person | scene
  model          String
  quality        String
  prompt         String
  imageUrl       String?  // null se a arte não foi salva no storage
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])

  @@index([createdAt])
}

// Músicas já sugeridas em playlists de jornada: as próximas evitam repetir.
model PlaylistSuggestion {
  id          String   @id @default(uuid())
  userId      String
  spotifyId   String
  suggestedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId, suggestedAt])
}

model ListeningHistory {
  id       String   @id @default(uuid())
  userId   String
  trackId  String
  playedAt DateTime
  track    Track    @relation(fields: [trackId], references: [spotifyId])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([userId, trackId, playedAt])
}

model MoodReaction {
  id             String       @id @default(uuid())
  moodAnalysisId String
  userId         String
  emoji          String
  createdAt      DateTime     @default(now())

  moodAnalysis   MoodAnalysis @relation(fields: [moodAnalysisId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([moodAnalysisId, userId])
}

model MoodComment {
  id             String       @id @default(uuid())
  moodAnalysisId String
  userId         String
  text           String
  createdAt      DateTime     @default(now())

  moodAnalysis   MoodAnalysis @relation(fields: [moodAnalysisId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Bichinho do usuário (card do humor atual). Um por conta; as ações vêm do humor, não ficam guardadas.
model Pet {
  id        String   @id @default(uuid())
  userId    String   @unique
  name      String
  species   String // gota | gato | coelho | broto
  color     String // menta | lilas | rosa | pessego | ceu | grafite
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

// Reações e comentários nas playlists do feed (os do humor ficam em MoodReaction/MoodComment).
model PlaylistReaction {
  id             String       @id @default(uuid())
  mofyPlaylistId String
  userId         String
  emoji          String
  createdAt      DateTime     @default(now())

  mofyPlaylist   MofyPlaylist @relation(fields: [mofyPlaylistId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mofyPlaylistId, userId])
}

model PlaylistComment {
  id             String       @id @default(uuid())
  mofyPlaylistId String
  userId         String
  text           String
  createdAt      DateTime     @default(now())

  mofyPlaylist   MofyPlaylist @relation(fields: [mofyPlaylistId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mofyPlaylistId, createdAt])
}
